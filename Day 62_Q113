/*
Q113: Write a program to take an integer array arr and an integer k as inputs.
The task is to find the kth smallest element in the array. Print the kth
smallest element as output.

Sample Test Cases:

Input 1:
10
10 5 4 3 48 6 2 33 53 10
4

Output 1:
5

Input 2:
5
7 2 9 1 5
2

Output 2:
2
*/

#include <stdio.h>

int main() {
    int n, k, i, j, temp;

    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &k);

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("%d", arr[k - 1]);

    return 0;
}
